  "sources": {
    "checkContract": {"type":"module","file":".claude/skills/team-kit-create/scripts/check-contract.mjs"},
    "assessRigor": {"type":"module","file":".claude/skills/team-kit-create/scripts/assess-rigor.mjs"},
    "freshChecks": {"type":"jsonFence","file":".claude/skills/team-kit-create/references/fresh-checks.md"},
    "shapes": {
      "type": "regexAlternatives",
      "file": ".claude/skills/team-kit-create/scripts/check-contract.mjs",
      "pattern": "^const SHAPE = /\\^Shape: \\(([a-z|]+)\\)",
      "drop": ["pending"]
