      "phrases": [
        {
          "id": "latitude-low-medium",
          "re": "Rigor: low\\W{0,4}or\\W{0,4}(Rigor: )?medium\\b[^.]{0,40}latitude|latitude[^.]{0,80}Rigor: low\\W{0,4}or\\W{0,4}(Rigor: )?medium|reads Rigor: low or Rigor: medium",
          "why": "latitude applies at every rigor level since 2026-11-18 (rigor.md → Plan latitude)"
        },
        {
          "id": "latitude-below-high",
          "re": "below high[^.]{0,80}Plan latitude|latitude[^.]{0,40}only below high",
          "why": "latitude applies at every rigor level since 2026-11-18"
        },
        {
          "id": "two-map-sections",
          "re": "Read the two map\\.md sections",
          "why": "the goal audit reads three map.md sections (Destination, Out of scope, Next slices)"
        },
        {"id":"rows-rule-high","re":"\\| high \\|[^|]*50\\+ rows","why":"research rows left the high rule (DD-6): only 10+ packages reach high"},
        {"id":"exit2-plain-research","re":"\\| 2 \\| research \\||\\| research — ","why":"discovery exit 2 is \"research or experiment\""},
        {
          "id": "one-task-every-cell",
          "re": "one task that executes every DoD verify cell",
          "flags": "i",
          "why": "validate, grade and seal split the verify cells (FRAMEWORK.md → Required verification coverage)"
        },
        {"id":"destination-without-shape","re":"Budget, Rigor lines\\)","why":"the Destination header block includes the Shape line"},
        {
          "id": "rigor-pin-unpinned",
          "re": "Rigor: medium \\(raised from <pin>",
          "why": "a pinned level keeps \"pinned\" in its line or assess-rigor --check demands the assessed level"
        },
        {
          "id": "lane-decisions-observation",
          "re": "needs no ruling,? is still CLEAN: record it under ## Lane decisions",
          "why": "an observation goes under ## Reviewer Notes; ## Lane decisions holds latitude choices"
        },
        {
          "id": "premise-deferral-basis",
          "source": "deferrals",
          "re": "unmeasured: (?:{alts})\\b",
          "flags": "i",
          "why": "a deferral is no basis: check-contract.mjs rejects it (its deferred list)"
        }
      ]
    },
