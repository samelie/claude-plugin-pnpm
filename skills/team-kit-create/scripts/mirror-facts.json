    "pinWord": {
      "type": "regexAlternatives",
      "file": ".claude/skills/team-kit-create/scripts/assess-rigor.mjs",
      "pattern": "pinned: match\\[2\\]\\.includes\\('([a-z]+)'\\)"
    }
