#!/usr/bin/env bash
# session-start - SessionStart hook for team
# team-session/ is a PERSISTENT, untracked real directory at the repo root.
# Team run subfolders (YYYYMMDD-{slug}) accumulate here and are KEPT FOREVER.
# Never stored in $TMPDIR; never deleted on session start (records must survive).

SESSION_ROOT="team-session"

# One-time migration: legacy versions symlinked team-session/ into $TMPDIR
# (where macOS purges it). Convert that symlink into a real dir, preserving
# whatever survived in the temp target.
if [ -L "$SESSION_ROOT" ]; then
  LEGACY_TARGET="$(readlink "$SESSION_ROOT")"
  rm -f "$SESSION_ROOT"
  mkdir -p "$SESSION_ROOT"
  if [ -d "$LEGACY_TARGET" ]; then
    cp -R "$LEGACY_TARGET/." "$SESSION_ROOT/" 2>/dev/null || true
  fi
fi

# Ensure the persistent dir exists. NEVER delete an existing one.
mkdir -p "$SESSION_ROOT"

SESSION_DIR="$(pwd)/$SESSION_ROOT"
NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Permanent append-only log of every CC session start.
echo "{\"startedAt\": \"${NOW}\", \"path\": \"${SESSION_DIR}\"}" >> "$SESSION_DIR/_sessions.jsonl"
# Latest-pointer meta.json (back-compat with readers that expect it).
echo "{\"startedAt\": \"${NOW}\", \"path\": \"${SESSION_DIR}\"}" > "$SESSION_DIR/meta.json"

# Build context
BASE="Team session directory ready at team-session/ (persistent untracked dir at ${SESSION_DIR}). Past team runs are kept here permanently. Use write-findings and read-findings skills to exchange data between agents."

if [ -f .claude/team-domain.md ]; then
  DOMAIN_RAW=$(cat .claude/team-domain.md)
  FULL_CTX=$(printf '%s\n\n--- DOMAIN CONTEXT ---\n%s' "$BASE" "$DOMAIN_RAW")
else
  FULL_CTX="$BASE"
fi

# JSON-encode the context string safely
json_encode() {
  if command -v jq &>/dev/null; then
    printf '%s' "$1" | jq -Rs .
  elif command -v python3 &>/dev/null; then
    printf '%s' "$1" | python3 -c "import json, sys; print(json.dumps(sys.stdin.read()))"
  else
    # fallback: escape basics for JSON string
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s=$(printf '%s' "$s" | awk '{if(NR>1) printf "\\n"; printf "%s", $0}')
    printf '"%s"' "$s"
  fi
}

ENCODED=$(json_encode "$FULL_CTX")
echo "{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":${ENCODED}}}"
